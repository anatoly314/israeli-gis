# Viewer build (reproducible with `npm run build:viewer`, see README) and Playwright output
dist/site/
test-results/
playwright-report/

# Build staging (pipeline/build.ts swaps it into dist/data only after every check passes)
dist/.data-staging-*/
dist/data.previous-*/

# Raw data: commit only what the pipeline reads (see README "Raw data").
data/raw/**/*.gdb/
data/raw/**/*.pdf
